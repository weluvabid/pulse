#!/bin/sh
set -eu

MESSAGE_FILE=${1:?commit message file is required}
SUBJECT=$(sed -n '1p' "$MESSAGE_FILE")

if printf '%s\n' "$SUBJECT" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<'MESSAGE'
Invalid commit subject.
Use Conventional Commits, for example:
  feat(runtime): add computed invalidation
  fix(scheduler): preserve queued jobs after errors
  test: cover nested batch failures
MESSAGE
exit 1
