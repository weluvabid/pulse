{
  "name": "@weluvabid/pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, framework-independent reactive runtime.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:demo",
    "build:core": "npm run clean && tsc -p tsconfig.build.json",
    "build:demo": "npm --prefix demo run build",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "dev": "npm --prefix demo run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck:core && npm run typecheck:demo",
    "typecheck:core": "tsc --noEmit",
    "typecheck:demo": "npm --prefix demo run check",
    "format": "prettier --write . && npm --prefix demo run format",
    "format:check": "prettier --check . && npm --prefix demo run format:check",
    "benchmark": "npm run build:core && node benchmarks/reactivity.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/node": "22.18.6",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "typescript-eslint": "8.46.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
