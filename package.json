{
  "name": "@weluvabid/pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, framework-independent reactive runtime.",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:hardening": "vitest run tests/property.test.ts tests/adversarial.test.ts",
    "benchmark": "npm run build && node benchmarks/reactivity.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@types/node": "22.18.6",
    "eslint": "9.39.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0",
    "vitest": "5.0.5"
  }
}
